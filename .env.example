APP_NAME=AI Face Service
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

MAX_UPLOAD_SIZE_MB=10
SIMILARITY_THRESHOLD=0.50
MAX_IDENTIFY_CANDIDATES=500
# Leave empty to use the SQLite fallback below. When this service runs in
# Docker and PostgreSQL runs on the host, use host.docker.internal instead of
# localhost, for example:
# FACE_DATABASE_URL=postgresql://smart_attendance:change-me@host.docker.internal:5432/smart_attendance
FACE_DATABASE_URL=
FACE_DATABASE_PATH=data/faces.db
FACE_DATABASE_TIMEOUT_SECONDS=5.0

INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_MODEL_ROOT=~/.insightface
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CONTEXT_ID=0
INSIGHTFACE_DETECTION_THRESHOLD=0.50
INSIGHTFACE_DETECTION_WIDTH=640
INSIGHTFACE_DETECTION_HEIGHT=640
MAX_IMAGE_PIXELS=20000000
MIN_IMAGE_WIDTH=160
MIN_IMAGE_HEIGHT=160
MIN_FACE_SIZE_PIXELS=80
MIN_BLUR_SCORE=30.0
PERFORMANCE_SAMPLE_LIMIT=1000
